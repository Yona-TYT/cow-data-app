<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_loing"
    tools:context=".AddActivity">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/my_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        tools:ignore="MissingConstraints" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="15dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="15dp" />


    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/InputData1"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:hint="Ingrese Nombre"
        android:imeOptions="actionNext"
        android:inputType="textCapWords"
        android:maxLength="35"
        android:maxLines="1"
        android:padding="5dp"
        android:singleLine="true"
        android:textSize="@dimen/textViewAdd"
        app:errorEnabled="true"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toTopOf="@+id/guideline6" />

    <Spinner
        android:id="@+id/spinType"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:textSize="@dimen/textViewLong"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintStart_toEndOf="@+id/InputData1"
        app:layout_constraintTop_toTopOf="@+id/InputData1" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/InputData2"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:hint="Ingrese Color"
        android:inputType="textCapWords"
        android:maxLength="35"
        android:maxLines="1"
        android:padding="5dp"
        android:singleLine="true"
        android:textSize="@dimen/textViewAdd"
        app:errorEnabled="true"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toBottomOf="@+id/InputData1"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/InputData3"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:hint="Ingrese Litros"
        android:inputType="number"
        android:maxLength="10"
        android:maxLines="1"
        android:padding="5dp"
        android:singleLine="true"
        android:textSize="@dimen/textViewAdd"
        app:errorEnabled="true"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toBottomOf="@+id/InputData2"
        tools:ignore="MissingConstraints" />


    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputData4"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:hint="Ingrese Edad"
        android:inputType="number"
        android:maxLength="10"
        android:maxLines="1"
        android:padding="5dp"
        android:singleLine="true"
        android:textSize="@dimen/textViewAdd"
        app:errorEnabled="true"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toBottomOf="@+id/InputData3"
        tools:ignore="MissingConstraints" />

    <Spinner
        android:id="@+id/spinAddEdad"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:textSize="@dimen/textViewLong"
        android:singleLine="true"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintStart_toEndOf="@+id/inputData4"
        app:layout_constraintTop_toBottomOf="@+id/InputData3" />


    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputData5"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:hint="dd/mm/aaaa"
        android:inputType="date"
        android:maxLength="10"
        android:maxLines="1"
        android:padding="5dp"
        android:singleLine="true"
        android:textSize="@dimen/textViewAdd"
        app:errorEnabled="true"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toBottomOf="@+id/inputData4"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/ADDswPre"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:padding="10dp"
        android:text="Preñada"
        android:textSize="@dimen/textViewLong"
        android:textAlignment="textStart"


        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintStart_toEndOf="@+id/inputData5"
        app:layout_constraintTop_toBottomOf="@+id/inputData4" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="169dp"
        android:layout_height="20dp"
        android:layout_marginTop="60dp"
        android:text="Imagen / Foto:"
        android:textSize="@dimen/textView"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toBottomOf="@+id/inputData5" />

    <ImageButton
        android:id="@+id/buttCam"
        android:layout_width="70dp"
        android:layout_height="50dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="60dp"
        android:backgroundTint="@color/float_button"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toEndOf="@+id/imgPrev"
        app:layout_constraintTop_toTopOf="@+id/imgPrev"
        app:srcCompat="@android:drawable/ic_menu_gallery" />

    <ImageView
        android:id="@+id/imgPrev"
        android:layout_width="122dp"
        android:layout_height="122dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toBottomOf="@+id/textView6"
        tools:srcCompat="@tools:sample/backgrounds/scenic" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/buttAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:backgroundTint="@color/float_button"
        android:text="@string/btagregar"
        android:textColor="@color/inner_button"
        android:textSize="20sp"
        android:textStyle="bold"
        app:fabSize="normal"
        app:icon="@drawable/add_button"
        app:iconTint="@color/inner_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline5"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/guideline4" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="124dp" />


</androidx.constraintlayout.widget.ConstraintLayout>