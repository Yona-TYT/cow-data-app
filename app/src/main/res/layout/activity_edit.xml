<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_loing"
    tools:context=".activitys.EditActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="15dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="15dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="56dp" />


    <Spinner
        android:id="@+id/spinType"
        android:layout_width="@dimen/textViewW"
        android:layout_height="38dp"
        android:layout_marginTop="5dp"
        android:textSize="@dimen/textViewLong"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textEditView2"
        app:layout_constraintTop_toBottomOf="@+id/textEditView2" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/my_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        tools:ignore="MissingConstraints" />


    <TextView
        android:id="@+id/textEditView1"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewH"
        android:layout_marginTop="10dp"
        android:text="Nombre:"
        android:textSize="@dimen/textView"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txEdit1"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:text="@string/textVacio"
        android:textSize="@dimen/textViewLong"
        android:textStyle="bold"
        android:maxLength="35"
        android:maxLines="1"
        android:singleLine="true"
        app:errorEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/textEditView1"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textEditView2"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewH"
        android:layout_marginTop="16dp"
        android:text="Color:"
        android:textSize="@dimen/textView"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/txEdit1"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txEdit2"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:text="@string/textVacio"
        android:textSize="@dimen/textViewLong"
        android:textStyle="bold"
        android:maxLength="35"
        android:maxLines="1"
        android:singleLine="true"
        app:errorEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/textEditView2"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textEditView3"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewH"
        android:layout_marginTop="10dp"
        android:text="Litros:"
        android:textSize="@dimen/textView"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/txEdit2"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txEdit3"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:text="@string/textVacio"
        android:textSize="@dimen/textViewLong"
        android:textStyle="bold"
        android:inputType="number"
        android:maxLength="10"
        android:maxLines="1"
        android:singleLine="true"
        app:errorEnabled="true"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/textEditView3"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textEditView4"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewH"
        android:layout_marginTop="10dp"
        android:text="Edad / F. Nacim.:"
        android:textSize="@dimen/textView"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/txEdit3"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txEdit4"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:text="@string/textVacio"
        android:textSize="@dimen/textViewLong"
        android:textStyle="bold"
        android:inputType="number"
        android:maxLength="10"
        android:maxLines="1"
        android:singleLine="true"
        app:errorEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/textEditView4"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textEditView5"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewH"
        android:layout_marginTop="10dp"
        android:text="Fecha Preñez:"
        android:textSize="@dimen/textView"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/txEdit4"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txEdit5"
        android:layout_width="@dimen/textViewW"
        android:layout_height="@dimen/textViewAddH"
        android:hint="dd/mm/aaaa"
        android:inputType="date"
        android:maxLength="10"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="@dimen/textViewLong"
        android:textStyle="bold"
        app:errorEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/textEditView5"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swPre"
        android:layout_width="@dimen/textViewW"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:text="Preñada"
        android:padding="6dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/txEdit5"
        app:layout_constraintTop_toBottomOf="@+id/textEditView5" />


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="324dp"
        android:layout_height="153dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toTopOf="@+id/guideline10"
        tools:srcCompat="@tools:sample/backgrounds/scenic" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left" />


    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swDelete"
        android:layout_width="@dimen/textViewW"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"

        android:padding="6dp"
        android:text="Modo Eliminar"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/buttOK"
        app:layout_constraintVertical_bias="0.0" />

    <Spinner
        android:id="@+id/spinEdad"
        android:layout_width="@dimen/textViewW"
        android:layout_height="38dp"
        android:textSize="@dimen/textViewLong"
        android:singleLine="true"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/txEdit4"
        app:layout_constraintTop_toBottomOf="@+id/textEditView4" />

    <ImageButton
        android:id="@+id/bttGall"
        android:layout_width="72dp"
        android:layout_height="63dp"
        android:backgroundTint="@color/float_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.711"
        app:layout_constraintStart_toEndOf="@+id/buttOK"
        app:layout_constraintTop_toTopOf="@+id/buttOK"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@android:drawable/ic_menu_gallery" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/buttDEL"
        android:layout_width="144dp"
        android:layout_height="42dp"
        android:clickable="true"
        android:focusable="true"
        android:text="Eliminar"
        android:textColor="@color/alert_text"
        android:textStyle="bold"
        android:visibility="invisible"
        app:backgroundTint="@color/alert_background"
        app:fabSize="mini"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconTint="@color/alert_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.079"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/buttOK"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/buttOK"
        android:layout_width="144dp"
        android:layout_height="42dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="20dp"

        android:clickable="true"
        android:focusable="true"
        android:text="Guardar"
        android:textColor="@color/inner_button"
        android:textStyle="bold"
        app:backgroundTint="@color/float_button"
        app:fabSize="mini"
        app:icon="@android:drawable/ic_menu_save"
        app:iconTint="@color/inner_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/buttMORE"
        app:layout_constraintVertical_bias="0.0" />


    <Button
        android:id="@+id/buttMORE"
        android:layout_width="148dp"
        android:layout_height="38dp"
        android:backgroundTint="@color/button"
        android:text="otros"
        android:textColor="@color/inner_button"
        android:layout_marginTop="10dp"

        app:layout_constraintEnd_toStartOf="@+id/guideline9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline8"
        app:layout_constraintTop_toBottomOf="@+id/txEdit5" />


</androidx.constraintlayout.widget.ConstraintLayout>