<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_loing"
    tools:context=".MoreActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/my_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="0dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txEdit1"
        android:layout_width="320dp"
        android:layout_height="@dimen/textViewAddH"
        android:layout_marginTop="100dp"
        android:hint="Ingrese madre de:"
        android:maxLength="300"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="@dimen/textViewLong"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/guideline14"
        app:layout_constraintStart_toStartOf="@+id/guideline13"
        app:layout_constraintTop_toBottomOf="@+id/my_toolbar"
        tools:ignore="MissingConstraints" />

    <ListView
        android:id="@+id/listMore1"
        android:layout_width="320dp"
        android:layout_height="118dp"
        android:background="?attr/colorBackgroundFloating"
        android:translationZ="999dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toStartOf="@+id/guideline14"
        app:layout_constraintStart_toStartOf="@+id/guideline13"
        app:layout_constraintTop_toBottomOf="@+id/txEdit1" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txEdit2"
        android:layout_width="320dp"
        android:layout_height="@dimen/textViewAddH"
        android:hint="Ingrese hija de:"
        android:maxLength="35"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="@dimen/textViewLong"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline14"
        app:layout_constraintStart_toStartOf="@+id/guideline13"
        app:layout_constraintTop_toBottomOf="@+id/txEdit1"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintHorizontal_bias="0.5" />

    <ListView
        android:id="@+id/listMore2"
        android:layout_width="320dp"
        android:layout_height="118dp"
        android:background="?attr/colorBackgroundFloating"
        android:translationZ="999dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toStartOf="@+id/guideline14"
        app:layout_constraintStart_toStartOf="@+id/guideline13"
        app:layout_constraintTop_toBottomOf="@+id/txEdit2" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txEdit3"
        android:layout_width="320dp"
        android:layout_height="@dimen/textViewAddH"
        android:hint="@string/more"
        android:maxLength="35"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="@dimen/textViewLong"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline14"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline13"
        app:layout_constraintTop_toBottomOf="@+id/txEdit2"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txEdit4"
        android:layout_width="320dp"
        android:layout_height="@dimen/textViewAddH"
        android:hint="@string/more"
        android:maxLength="35"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="@dimen/textViewLong"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline14"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline13"
        app:layout_constraintTop_toBottomOf="@+id/txEdit3"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="39dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="30dp" />

    <Button
        android:id="@+id/buttOK"
        android:layout_width="110dp"
        android:layout_height="40dp"
        android:layout_marginEnd="232dp"
        android:layout_marginBottom="100dp"
        android:backgroundTint="@color/button"
        android:text="OK"
        android:textColor="@color/inner_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline14"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline13" />

    <Button
        android:id="@+id/buttCANC"
        android:layout_width="110dp"
        android:layout_height="40dp"
        android:layout_marginStart="140dp"
        android:layout_marginBottom="100dp"
        android:backgroundTint="@color/button"
        android:text="Cancelar"
        android:textColor="@color/inner_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline14"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/guideline13" />


</androidx.constraintlayout.widget.ConstraintLayout>